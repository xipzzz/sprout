# Zhipu GLM-4.6V — only needed for a live read of your own photo.
# The sample photo (npm run exam, then "Try the sample photo") runs without this.
# Leave the value empty in git. Put the real value in .env (gitignored), or on a Mac:
#   security add-generic-password -s sprout -a ZHIPU_API_KEY -w
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.6v

# Obsidian note. One Markdown file per scan, named YYYY-MM-DD-subject.md
SPROUT_VAULT_DIR=/Users/ml/Documents/10_Obsidian/Xip/Sprout

# Optional second copy in another local folder. Leave empty to save only in the vault.
SPROUT_SAVE_DIR=
